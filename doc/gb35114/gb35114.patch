+     *
+     * @return 原因描述；本平台从未给该设备签发过证书时返回 {@code null}
+     */
+    String describeDeviceCertUnavailable(String gbId);
+
+    /** 吊销证书。 */
+    void revokeCert(int id);
+
+    /** 删除证书（本地身份证书连同其私钥一并删除）。 */
+    void deleteCert(int id);
+}
