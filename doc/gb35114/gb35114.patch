+    }
+
+    /** 用 CA 身份签发一张 SM2 证书（完整 DN 版本）。 */
+    public static Gb35114Identity issue(Gb35114Identity ca, X500Name subject,
+                                        Date notBefore, Date notAfter) throws Exception {
