+            ca.setNotAfter(CERT_TIME.format(cert.getNotAfter().toInstant()));
+            ca.setRemark(remark);
+            ca.setCreateTime(DateUtil.getNow());
+            caMapper.add(ca);
+            return ca;
+        } catch (Exception e) {
+            log.error("[GB35114] 导入 CA 失败", e);
+            throw new RuntimeException("导入 CA 失败: " + e.getMessage(), e);
+        }
+    }
