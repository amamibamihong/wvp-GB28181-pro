+     */
+    X509Certificate validateAnnouncedDeviceCert(String gbId, X509Certificate cert);
+
+    /**
+     * 说明某设备为何取不到可用的下级客户端证书。
+     *
+     * <p>{@link #queryIssuedDeviceCert(String)} 返回 {@code null} 有两种原因 ——
+     * 「本平台没给这台设备签发过」和「签发过但已吊销/过期」，二者的处置完全不同
