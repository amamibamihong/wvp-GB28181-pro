+package com.genersoft.iot.vmp.gb35114.sip;
+
+import com.genersoft.iot.vmp.gb35114.cert.bean.Gb35114Ca;
+import com.genersoft.iot.vmp.gb35114.cert.dao.Gb35114CaMapper;
+import com.genersoft.iot.vmp.gb35114.cert.dao.Gb35114CertMapper;
+import com.genersoft.iot.vmp.gb35114.cert.service.impl.Gb35114CertServiceImpl;
+import com.genersoft.iot.vmp.gb35114.conf.Gb35114Config;
+import com.genersoft.iot.vmp.gb35114.crypto.Gb35114CertUtil;
+import org.bouncycastle.asn1.x500.X500Name;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+import java.lang.reflect.Field;
+import java.util.Date;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.when;
+
+/**
+ * 两件事的回归：
+ *
+ * <ol>
+ *   <li><b>全局跳过链校验</b>（{@code gb35114.skip-cert-chain-verify}）—— 拿不到 CA 时的
+ *       逃生口，默认关闭；打开后不再要求「由已导入的 CA 签发」；</li>
+ *   <li><b>按签发者 DN 缩小候选</b> —— 验签前先用 issuer/subject 的 DN 关系排除不可能
+ *       的 CA，避免对每张 CA 都做一次 SM2 验签。</li>
+ * </ol>
+ *
+ * <p>第 2 点最要紧的是<b>不能误伤</b>：DN 缩小的前提是「issuer DN 必然等于签发 CA 的
+ * subject DN」，这个前提本身可靠（本平台签发时传的就是 CA 证书的 subject），但存量数据
+ * 的 {@code subject_dn} 可能为空、DN 写法也可能有差异，因此命中为空时必须退回原候选集。
+ * 下面 {@code dnNarrowing*} 一组用例就是把这条钉住。
+ */
+class Gb35114CertChainSkipAndDnNarrowTest {
+
+    private static final long DAY = 24L * 3600 * 1000;
+    private static final String DEVICE_ID = "35020000001320000001";
+
+    private Gb35114CertServiceImpl service;
+    private Gb35114CaMapper caMapper;
+    private Gb35114Config config;
+
+    private static void inject(Object target, String field, Object value) throws Exception {
+        Field f = target.getClass().getDeclaredField(field);
+        f.setAccessible(true);
+        f.set(target, value);
+    }
+
+    @BeforeEach
+    void setUp() throws Exception {
+        service = new Gb35114CertServiceImpl();
+        caMapper = Mockito.mock(Gb35114CaMapper.class);
+        config = new Gb35114Config();
+        inject(service, "caMapper", caMapper);
+        inject(service, "certMapper", Mockito.mock(Gb35114CertMapper.class));
+        inject(service, "config", config);
+    }
+
+    private static Date later(int days) {
+        return new Date(System.currentTimeMillis() + days * DAY);
+    }
+
+    private static X500Name name(String cn) {
+        return new X500Name("CN=" + cn);
+    }
+
+    private static Gb35114Ca ca(int id, String type,
+                                Gb35114CertUtil.Gb35114Identity identity,
+                                boolean fillSubjectDn) {
+        Gb35114Ca record = new Gb35114Ca();
+        record.setId(id);
+        record.setType(type);
+        record.setSubjectCn(Gb35114CertUtil.subjectDn(identity.certificate));
+        if (fillSubjectDn) {
+            record.setSubjectDn(Gb35114CertUtil.subjectDn(identity.certificate));
+        }
+        record.setCertPem(identity.certPem);
+        return record;
+    }
+
+    // ------------------------------------------------------------------
+    // 一、全局跳过链校验
+    // ------------------------------------------------------------------
+
+    /**
+     * 开关关闭（默认）时，链不成立照样拒绝 —— 先钉住默认行为，
+     * 否则「默认验证」这句话没有测试兜底。
+     */
+    @Test
+    void defaultStillVerifiesChain() throws Exception {
+        Gb35114CertUtil.Gb35114Identity localCa = Gb35114CertUtil.generateSelfSigned(
+                name("Local CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity foreignCa = Gb35114CertUtil.generateSelfSigned(
+                name("Foreign CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity device = Gb35114CertUtil.issue(
+                foreignCa, name(DEVICE_ID), new Date(), later(365));
+
+        assertFalse(config.isSkipCertChainVerify(), "前提：默认必须是验证");
+        when(caMapper.query(8)).thenReturn(ca(8, Gb35114Ca.TYPE_LOCAL_CA, localCa, true));
+
+        assertThrows(Gb35114Exception.class,
+                () -> service.validateDeviceCertChain(DEVICE_ID, device.certificate, 8));
+    }
+
+    /** 开关打开后，非本平台 CA 签发的设备证书也放行。 */
+    @Test
+    void skipAllowsDeviceCertNotSignedByOurCa() throws Exception {
+        Gb35114CertUtil.Gb35114Identity foreignCa = Gb35114CertUtil.generateSelfSigned(
+                name("Foreign CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity device = Gb35114CertUtil.issue(
+                foreignCa, name(DEVICE_ID), new Date(), later(365));
+
+        config.setSkipCertChainVerify(true);
+
+        assertSame(device.certificate,
+                service.validateDeviceCertChain(DEVICE_ID, device.certificate, 8));
+    }
+
+    /**
+     * 开关打开时，<b>连「本平台一张 CA 都没有」也不该再拦</b>。
+     *
+     * <p>这条正是开关存在的理由：现场拿不到 CA，如果仍然因为「没配 CA」被挡，
+     * 这个逃生口就白开了。
+     */
+    @Test
+    void skipBypassesNoCaConfigured() throws Exception {
+        Gb35114CertUtil.Gb35114Identity someCa = Gb35114CertUtil.generateSelfSigned(
+                name("Some CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity device = Gb35114CertUtil.issue(
+                someCa, name(DEVICE_ID), new Date(), later(365));
+
+        config.setSkipCertChainVerify(true);
+        when(caMapper.queryByType(Mockito.anyString())).thenReturn(java.util.Collections.emptyList());
+
+        assertSame(device.certificate,
+                service.validateDeviceCertChain(DEVICE_ID, device.certificate, null));
+    }
+
+    /** 上级方向同样受开关控制：打开后自签且未导入为上级 CA 的证书也放行。 */
+    @Test
+    void skipAllowsUpstreamCertNotBackedByImportedCa() throws Exception {
+        Gb35114CertUtil.Gb35114Identity upstream = Gb35114CertUtil.generateSelfSigned(
+                name("Upstream Platform"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_ENTITY);
+
+        // 先确认默认行为是拒绝
+        when(caMapper.queryByType(Gb35114Ca.TYPE_TRUSTED_CA))
+                .thenReturn(java.util.Collections.emptyList());
+        assertThrows(Gb35114Exception.class,
+                () -> service.validateUpstreamPlatformCertChain(upstream.certificate));
+
+        config.setSkipCertChainVerify(true);
+        assertSame(upstream.certificate,
+                service.validateUpstreamPlatformCertChain(upstream.certificate));
+    }
+
+    /** 空证书在任何取值下都返回 null，不受开关影响。 */
+    @Test
+    void nullCertStaysNullUnderSkip() {
+        config.setSkipCertChainVerify(true);
+        assertNull(service.validateDeviceCertChain(DEVICE_ID, null, null));
+        assertNull(service.validateUpstreamPlatformCertChain(null));
+    }
+
+    // ------------------------------------------------------------------
+    // 二、按签发者 DN 缩小候选
+    // ------------------------------------------------------------------
+
+    /**
+     * DN 对得上的 CA 被优先命中 —— 正常路径不受影响。
+     * 这里 CA 记录填了 {@code subject_dn}，缩小后仍应通过。
+     */
+    @Test
+    void dnNarrowingKeepsMatchingCa() throws Exception {
+        Gb35114CertUtil.Gb35114Identity localCa = Gb35114CertUtil.generateSelfSigned(
+                name("Local CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity device = Gb35114CertUtil.issue(
+                localCa, name(DEVICE_ID), new Date(), later(365));
+
+        when(caMapper.query(8)).thenReturn(ca(8, Gb35114Ca.TYPE_LOCAL_CA, localCa, true));
+
+        assertSame(device.certificate,
+                service.validateDeviceCertChain(DEVICE_ID, device.certificate, 8));
+    }
+
+    /**
+     * <b>关键</b>：{@code subject_dn} 为空的存量记录必须保留在候选里。
+     *
+     * <p>该列是后加的，存量 CA 行可能为空。若按「DN 对不上就排除」处理，
+     * 这些 CA 会被全部排除，导致设备整批接不进来 —— 而这与「证书是否真的由它签发」
+     * 毫无关系。这里构造一条 subject_dn 为空的记录，验证仍能通过。
+     */
+    @Test
+    void dnNarrowingKeepsCaWithBlankSubjectDn() throws Exception {
+        Gb35114CertUtil.Gb35114Identity localCa = Gb35114CertUtil.generateSelfSigned(
+                name("Local CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity device = Gb35114CertUtil.issue(
+                localCa, name(DEVICE_ID), new Date(), later(365));
+
+        when(caMapper.query(8)).thenReturn(ca(8, Gb35114Ca.TYPE_LOCAL_CA, localCa, false));
+
+        assertSame(device.certificate,
+                service.validateDeviceCertChain(DEVICE_ID, device.certificate, 8));
+    }
+
+    /**
+     * 缩小后候选为空 → 退回原候选集，不因 DN 写法的细微差异误判。
+     *
+     * <p>构造一条 subject_dn 与真实 issuer <b>写法不同</b>（但仍是同一把密钥）的记录：
+     * 缩小会把它排除、候选变空，此时必须退回全表并由验签裁决 —— 而验签是能过的。
+     * 若忘了退回，这张证书就会被误拒。
+     */
+    @Test
+    void dnNarrowingFallsBackWhenNothingMatches() throws Exception {
+        Gb35114CertUtil.Gb35114Identity localCa = Gb35114CertUtil.generateSelfSigned(
+                name("Local CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity device = Gb35114CertUtil.issue(
+                localCa, name(DEVICE_ID), new Date(), later(365));
+
+        Gb35114Ca record = ca(8, Gb35114Ca.TYPE_LOCAL_CA, localCa, false);
+        // 故意写一个与 issuer 不同的 DN：缩小会排除它，从而触发「命中为空退回全表」
+        record.setSubjectDn("CN=Completely Different CA");
+        when(caMapper.query(8)).thenReturn(record);
+
+        assertSame(device.certificate,
+                service.validateDeviceCertChain(DEVICE_ID, device.certificate, 8),
+                "DN 缩小命中为空时必须退回全表，否则同一把密钥也会被误拒");
+    }
+
+    /**
+     * 缩小不得改变「该拒还是拒」的结论。
+     *
+     * <p>一张由别的 CA 签发的证书，即便把正确的 DN 填进候选集，缩小后仍应拒绝 ——
+     * 缩小是性能优化，不是判据。
+     */
+    @Test
+    void dnNarrowingDoesNotLoosenRejection() throws Exception {
+        Gb35114CertUtil.Gb35114Identity localCa = Gb35114CertUtil.generateSelfSigned(
+                name("Local CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity foreignCa = Gb35114CertUtil.generateSelfSigned(
+                name("Foreign CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity device = Gb35114CertUtil.issue(
+                foreignCa, name(DEVICE_ID), new Date(), later(365));
+
+        // 候选集里放的是 Local CA（与设备证书的签发者无关的那张）
+        when(caMapper.query(8)).thenReturn(ca(8, Gb35114Ca.TYPE_LOCAL_CA, localCa, true));
+
+        Gb35114Exception e = assertThrows(Gb35114Exception.class,
+                () -> service.validateDeviceCertChain(DEVICE_ID, device.certificate, 8));
+        assertTrue(e.getMessage().contains("不是由本平台已导入的任何 CA 签发"), "实际: " + e.getMessage());
+    }
+
+    /**
+     * 多个 CA 时，DN 缩小应命中正确的那一个。
+     *
+     * <p>候选集里放两张 CA（一张无关、一张是真正的签发者），缩小后仍须通过 ——
+     * 验证缩小是「按 DN 过滤」而不是「取第一个」。
+     */
+    @Test
+    void dnNarrowingPicksRightCaAmongMany() throws Exception {
+        Gb35114CertUtil.Gb35114Identity unrelated = Gb35114CertUtil.generateSelfSigned(
+                name("Unrelated CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity localCa = Gb35114CertUtil.generateSelfSigned(
+                name("Local CA"), new Date(), later(3650), Gb35114CertUtil.KEY_USAGE_CA);
+        Gb35114CertUtil.Gb35114Identity device = Gb35114CertUtil.issue(
+                localCa, name(DEVICE_ID), new Date(), later(365));
+
+        when(caMapper.queryByType(Gb35114Ca.TYPE_LOCAL_CA)).thenReturn(List.of(
+                ca(7, Gb35114Ca.TYPE_LOCAL_CA, unrelated, true),
+                ca(8, Gb35114Ca.TYPE_LOCAL_CA, localCa, true)));
+        when(caMapper.queryByType(Gb35114Ca.TYPE_TRUSTED_CA))
+                .thenReturn(java.util.Collections.emptyList());
+
+        assertSame(device.certificate,
+                service.validateDeviceCertChain(DEVICE_ID, device.certificate, null));
+    }
+}
diff --git a/src/test/java/com/genersoft/iot/vmp/gb35114/sip/Gb35114CertReferenceGuardTest.java b/src/test/java/com/genersoft/iot/vmp/gb35114/sip/Gb35114CertReferenceGuardTest.java
new file mode 100644
index 0000000..4eb6341
--- /dev/null
+++ b/src/test/java/com/genersoft/iot/vmp/gb35114/sip/Gb35114CertReferenceGuardTest.java
@@ -0,0 +1,175 @@
+package com.genersoft.iot.vmp.gb35114.sip;
+
+import com.genersoft.iot.vmp.gb28181.bean.Device;
+import com.genersoft.iot.vmp.gb28181.bean.Platform;
+import com.genersoft.iot.vmp.gb28181.dao.DeviceMapper;
+import com.genersoft.iot.vmp.gb28181.dao.PlatformMapper;
+import com.genersoft.iot.vmp.gb35114.cert.bean.Gb35114Cert;
+import com.genersoft.iot.vmp.gb35114.cert.bean.Gb35114Cert;
+import com.genersoft.iot.vmp.gb35114.cert.dao.Gb35114CaMapper;
+import com.genersoft.iot.vmp.gb35114.cert.dao.Gb35114CertMapper;
+import com.genersoft.iot.vmp.gb35114.cert.service.impl.Gb35114CertServiceImpl;
+import com.genersoft.iot.vmp.gb35114.conf.Gb35114Config;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+import java.lang.reflect.Field;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.when;
+
+/**
+ * 删除证书前的引用守卫（{@code assertNoCertReference}）。
+ *
+ * <p>证书被引用是按 <b>ID</b> 存的（{@code wvp_device.cert_id} / {@code server_cert_id}、
+ * {@code wvp_platform.device_cert_id} / {@code platform_cert_id}），删除后引用立刻悬空。
+ * 悬空不会当场报错，而是在<b>下一次设备注册</b>时才暴露成 403
+ * （{@code resolveServerCertId} 对「绑定的证书不可用」是直接拒绝，不静默回退）。
+ *
+ * <p>因此删除必须前置拦截，并且要<b>点名</b>是哪个设备/平台在引用 ——
+ * 只说「被引用」会让运维在一堆设备里翻找。
+ */
+class Gb35114CertReferenceGuardTest {
+
+    private static final int CERT_ID = 41;
+
+    private Gb35114CertServiceImpl service;
+    private Gb35114CertMapper certMapper;
+    private DeviceMapper deviceMapper;
+    private PlatformMapper platformMapper;
+
+    private static void inject(Object target, String field, Object value) throws Exception {
+        Field f = target.getClass().getDeclaredField(field);
+        f.setAccessible(true);
+        f.set(target, value);
+    }
+
+    @BeforeEach
+    void setUp() throws Exception {
+        service = new Gb35114CertServiceImpl();
+        certMapper = Mockito.mock(Gb35114CertMapper.class);
+        deviceMapper = Mockito.mock(DeviceMapper.class);
+        platformMapper = Mockito.mock(PlatformMapper.class);
+        inject(service, "certMapper", certMapper);
+        inject(service, "caMapper", Mockito.mock(Gb35114CaMapper.class));
+        inject(service, "deviceMapper", deviceMapper);
+        inject(service, "platformMapper", platformMapper);
+        inject(service, "config", new Gb35114Config());
+        when(deviceMapper.getAll()).thenReturn(List.of());
+        when(platformMapper.queryAll()).thenReturn(List.of());
+    }
+
+    private static Device device(String name, Integer certId, Integer serverCertId) {
+        Device d = new Device();
+        d.setName(name);
+        d.setCertId(certId);
+        d.setServerCertId(serverCertId);
+        return d;
+    }
+
+    private static Platform platform(String name, Integer deviceCertId, Integer platformCertId) {
+        Platform p = new Platform();
+        p.setName(name);
+        p.setDeviceCertId(deviceCertId);
+        p.setPlatformCertId(platformCertId);
+        return p;
+    }
+
+    /** 无人引用时删除放行。 */
+    @Test
+    void deleteSucceedsWhenNotReferenced() {
+        service.deleteCert(CERT_ID);
+        Mockito.verify(certMapper).delete(CERT_ID);
+    }
+
+    /** 设备按「国密服务端证书」绑定时拒绝删除，且点名设备。 */
+    @Test
+    void deviceServerCertBindingBlocksDelete() {
+        when(deviceMapper.getAll()).thenReturn(List.of(device("门口球机", null, CERT_ID)));
+
+        IllegalArgumentException e = assertThrows(IllegalArgumentException.class,
+                () -> service.deleteCert(CERT_ID));
+
+        assertTrue(e.getMessage().contains("门口球机"), "报错应点名设备: " + e.getMessage());
+        assertTrue(e.getMessage().contains("服务端证书"), "报错应说明绑定的是哪一类: " + e.getMessage());
+        Mockito.verify(certMapper, Mockito.never()).delete(CERT_ID);
+    }
+
+    /** 设备按「国密设备证书」绑定同样拦截。 */
+    @Test
+    void deviceCertBindingBlocksDelete() {
+        when(deviceMapper.getAll()).thenReturn(List.of(device("枪机", CERT_ID, null)));
+
+        IllegalArgumentException e = assertThrows(IllegalArgumentException.class,
+                () -> service.deleteCert(CERT_ID));
+        assertTrue(e.getMessage().contains("枪机"), e.getMessage());
+        Mockito.verify(certMapper, Mockito.never()).delete(CERT_ID);
+    }
+
+    /** 级联平台的两种绑定都要拦下（这是存量 #41 的真实形态）。 */
+    @Test
+    void platformBindingBlocksDelete() {
+        when(platformMapper.queryAll())
+                .thenReturn(List.of(platform("上级平台A", CERT_ID, CERT_ID)));
+
+        IllegalArgumentException e = assertThrows(IllegalArgumentException.class,
+                () -> service.deleteCert(CERT_ID));
+        assertTrue(e.getMessage().contains("上级平台A"), e.getMessage());
+        Mockito.verify(certMapper, Mockito.never()).delete(CERT_ID);
+    }
+
+    /** 一处引用都没有的行（绑的是别的 id）不阻塞删除。 */
+    @Test
+    void otherBindingsDoNotBlockDelete() {
+        when(deviceMapper.getAll()).thenReturn(List.of(device("设备", CERT_ID + 1, null)));
+        when(platformMapper.queryAll()).thenReturn(List.of(platform("平台", null, CERT_ID + 2)));
+
+        service.deleteCert(CERT_ID);
+        Mockito.verify(certMapper).delete(CERT_ID);
+    }
+
+    /**
+     * 查询本身失败时不能把「删除」变成一次必然失败的调用。
+     *
+     * <p>守卫是「顺手多看一眼」，不该因为设备表读不到就拒绝删除 ——
+     * 否则一个与证书无关的数据库故障会连带把证书管理页锁死。
+     */
+    @Test
+    void queryFailureDoesNotBlockDelete() {
+        when(deviceMapper.getAll()).thenThrow(new RuntimeException("db down"));
+        when(platformMapper.queryAll()).thenThrow(new RuntimeException("db down"));
+
+        service.deleteCert(CERT_ID);
+        Mockito.verify(certMapper).delete(CERT_ID);
+    }
+
+    /** 多台设备同时引用时报错应把它们都列出来，而不是只报第一个。 */
+    @Test
+    void allReferencesAreListed() {
+        when(deviceMapper.getAll()).thenReturn(List.of(
+                device("设备甲", null, CERT_ID),
+                device("设备乙", null, CERT_ID)));
+
+        IllegalArgumentException e = assertThrows(IllegalArgumentException.class,
+                () -> service.deleteCert(CERT_ID));
+        assertTrue(e.getMessage().contains("设备甲"), e.getMessage());
+        assertTrue(e.getMessage().contains("设备乙"), e.getMessage());
+    }
+
+    /**
+     * 守卫对<b>所有</b>证书一视同仁，不看用途。
+     *
+     * <p>这是有意的：对端证书（上级平台证书、下级设备证书）被级联/设备绑定时，
+     * 删除同样会让引用悬空 —— 而且 {@code deleteCert} 连查都不查这条记录，
+     * 直接扫引用，因此不可能出现「按用途跳过校验」的漏洞。
+     */
+    @Test
+    void guardIsIndependentOfCertType() {
+        when(platformMapper.queryAll()).thenReturn(List.of(platform("上级", null, CERT_ID)));
+
+        assertThrows(IllegalArgumentException.class, () -> service.deleteCert(CERT_ID));
+        Mockito.verify(certMapper, Mockito.never()).delete(CERT_ID);
+    }
+}
diff --git a/src/test/java/com/genersoft/iot/vmp/gb35114/sip/Gb35114CertUnbindAndDeleteTest.java b/src/test/java/com/genersoft/iot/vmp/gb35114/sip/Gb35114CertUnbindAndDeleteTest.java
new file mode 100644
index 0000000..4512e22
--- /dev/null
+++ b/src/test/java/com/genersoft/iot/vmp/gb35114/sip/Gb35114CertUnbindAndDeleteTest.java
@@ -0,0 +1,166 @@
+package com.genersoft.iot.vmp.gb35114.sip;
+
+import com.genersoft.iot.vmp.gb28181.bean.Device;
+import com.genersoft.iot.vmp.gb28181.bean.Platform;
+import com.genersoft.iot.vmp.gb28181.dao.DeviceMapper;
+import com.genersoft.iot.vmp.gb28181.dao.PlatformMapper;
+import com.genersoft.iot.vmp.gb35114.cert.dao.Gb35114CaMapper;
+import com.genersoft.iot.vmp.gb35114.cert.dao.Gb35114CertMapper;
+import com.genersoft.iot.vmp.gb35114.cert.service.impl.Gb35114CertServiceImpl;
+import com.genersoft.iot.vmp.gb35114.conf.Gb35114Config;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.InOrder;
+import org.mockito.Mockito;
+
+import java.lang.reflect.Field;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.inOrder;
+import static org.mockito.Mockito.when;
+
+/**
+ * 「删除并解绑」（{@code unbindAndDeleteCert}）—— 编辑页删自己证书的那条路径。
+ *
+ * <p>与 {@link Gb35114CertReferenceGuardTest} 覆盖的 {@code deleteCert} 不同：级联编辑页
+ * 删证书时，证书正被<b>本</b> platform 行按 ID 引用，直接删必被守卫拒绝。本方法先把
+ * {@code wvp_platform.device_cert_id} / {@code platform_cert_id} 中等于该 ID 的置空，
+ * 再走删除。
+ *
+ * <p>两条边界必须守住：
+ * <ol>
+ *   <li><b>只解绑级联平台，不动设备</b>：设备侧那张证书与级联无关，擅自解绑会把一台
+ *       正常在用的设备弄成「未配置证书」，下一次注册直接 403；</li>
+ *   <li><b>仍被别的平台/设备引用时照旧拒绝并点名</b>：解绑只是撤掉「本行」的引用，
+ *       不是无条件放行。</li>
+ * </ol>
+ */
+class Gb35114CertUnbindAndDeleteTest {
+
+    private static final int CERT_ID = 41;
+
+    private Gb35114CertServiceImpl service;
+    private Gb35114CertMapper certMapper;
+    private DeviceMapper deviceMapper;
+    private PlatformMapper platformMapper;
+
+    private static void inject(Object target, String field, Object value) throws Exception {
+        Field f = target.getClass().getDeclaredField(field);
+        f.setAccessible(true);
+        f.set(target, value);
+    }
+
+    @BeforeEach
+    void setUp() throws Exception {
+        service = new Gb35114CertServiceImpl();
+        certMapper = Mockito.mock(Gb35114CertMapper.class);
+        deviceMapper = Mockito.mock(DeviceMapper.class);
+        platformMapper = Mockito.mock(PlatformMapper.class);
+        inject(service, "certMapper", certMapper);
+        inject(service, "caMapper", Mockito.mock(Gb35114CaMapper.class));
+        inject(service, "deviceMapper", deviceMapper);
+        inject(service, "platformMapper", platformMapper);
+        inject(service, "config", new Gb35114Config());
+        when(deviceMapper.getAll()).thenReturn(List.of());
+        // 守卫读的是解绑「之后」的状态：解绑后本行已不再引用，故 queryAll 返回空
+        when(platformMapper.queryAll()).thenReturn(List.of());
+    }
+
+    private static Platform platform(String name, Integer deviceCertId, Integer platformCertId) {
+        Platform p = new Platform();
+        p.setName(name);
+        p.setDeviceCertId(deviceCertId);
+        p.setPlatformCertId(platformCertId);
+        return p;
+    }
+
+    private static Device device(String name, Integer certId, Integer serverCertId) {
+        Device d = new Device();
+        d.setName(name);
+        d.setCertId(certId);
+        d.setServerCertId(serverCertId);
+        return d;
+    }
+
+    /** 正常路径：两个引用列都清，然后删除。顺序不能反。 */
+    @Test
+    void clearsBothPlatformBindingsThenDeletes() {
+        when(platformMapper.clearDeviceCertBinding(CERT_ID)).thenReturn(1);
+        when(platformMapper.clearPlatformCertBinding(CERT_ID)).thenReturn(0);
+
+        service.unbindAndDeleteCert(CERT_ID);
+
+        InOrder order = inOrder(platformMapper, certMapper);
+        order.verify(platformMapper).clearDeviceCertBinding(CERT_ID);
+        order.verify(platformMapper).clearPlatformCertBinding(CERT_ID);
+        // 解绑必须发生在守卫查询之前，否则守卫看到的是解绑前的状态、照样拒绝
+        order.verify(platformMapper).queryAll();
+        order.verify(certMapper).delete(CERT_ID);
+        order.verifyNoMoreInteractions();
+    }
+
+    /** 一处都没绑定时照样删得掉 —— 解绑是幂等的，不该因为「没解除到」而中止。 */
+    @Test
+    void deletesEvenWhenNothingWasBound() {
+        when(platformMapper.clearDeviceCertBinding(CERT_ID)).thenReturn(0);
+        when(platformMapper.clearPlatformCertBinding(CERT_ID)).thenReturn(0);
+
+        service.unbindAndDeleteCert(CERT_ID);
+
+        Mockito.verify(certMapper).delete(CERT_ID);
+    }
+
+    /**
+     * 解绑后仍被<b>别的</b>平台引用 → 拒绝，并点名那个平台。
+     * 这是「两个上级共用一张证书」的存量数据场景。
+     */
+    @Test
+    void stillReferencedByAnotherPlatformIsRejectedAndNamed() {
+        when(platformMapper.clearDeviceCertBinding(CERT_ID)).thenReturn(0);
+        when(platformMapper.clearPlatformCertBinding(CERT_ID)).thenReturn(0);
+        when(platformMapper.queryAll()).thenReturn(List.of(
+                platform("上级乙", CERT_ID, null)));
+
+        IllegalArgumentException e = assertThrows(IllegalArgumentException.class,
+                () -> service.unbindAndDeleteCert(CERT_ID));
+
+        assertTrue(e.getMessage().contains("上级乙"), "应点名引用者，实际: " + e.getMessage());
+        assertTrue(e.getMessage().contains("国密设备证书"), "应说明是哪个槽，实际: " + e.getMessage());
+        Mockito.verify(certMapper, Mockito.never()).delete(CERT_ID);
+    }
+
+    /**
+     * 解绑<b>只</b>碰级联平台，不碰设备：设备仍按 ID 引用时照旧拒绝。
+     * 否则「在级联编辑页删证书」会顺手把一台在用设备弄成未配置证书。
+     */
+    @Test
+    void deviceReferenceIsNotUnboundAndStillBlocksDelete() {
+        when(platformMapper.clearDeviceCertBinding(CERT_ID)).thenReturn(0);
+        when(platformMapper.clearPlatformCertBinding(CERT_ID)).thenReturn(0);
+        when(deviceMapper.getAll()).thenReturn(List.of(
+                device("门口球机", null, CERT_ID)));
+
+        IllegalArgumentException e = assertThrows(IllegalArgumentException.class,
+                () -> service.unbindAndDeleteCert(CERT_ID));
+
+        assertTrue(e.getMessage().contains("门口球机"), "应点名设备，实际: " + e.getMessage());
+        assertTrue(e.getMessage().contains("国密服务端证书"), "应说明是哪个槽，实际: " + e.getMessage());
+        Mockito.verify(certMapper, Mockito.never()).delete(CERT_ID);
+    }
+
+    /**
+     * 两个槽指向同一张证书时，两次解绑都要发生（SQL 各清各的列），只删一次。
+     */
+    @Test
+    void sameCertInBothSlotsIsUnboundTwiceAndDeletedOnce() {
+        when(platformMapper.clearDeviceCertBinding(CERT_ID)).thenReturn(1);
+        when(platformMapper.clearPlatformCertBinding(CERT_ID)).thenReturn(1);
+
+        service.unbindAndDeleteCert(CERT_ID);
+
+        Mockito.verify(platformMapper).clearDeviceCertBinding(CERT_ID);
+        Mockito.verify(platformMapper).clearPlatformCertBinding(CERT_ID);
+        Mockito.verify(certMapper, Mockito.times(1)).delete(CERT_ID);
+    }
+}
diff --git a/src/test/java/com/genersoft/iot/vmp/gb35114/sip/Gb35114DeviceCnServiceTest.java b/src/test/java/com/genersoft/iot/vmp/gb35114/sip/Gb35114DeviceCnServiceTest.java
