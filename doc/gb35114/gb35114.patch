+-- C/ST/L/O/OU 会真的写进证书并落库，不再出现「DN 里有 C=CN、country 列却是 NULL」。
+DECLARE
+V_CNT INT;
+BEGIN
+SELECT COUNT(*) INTO V_CNT FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'WVP_GB35114_CA' AND COLUMN_NAME = 'SUBJECT_DN';
+IF V_CNT = 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_ca ADD subject_dn varchar(500)';
+END IF;
