+        return WVPResult.success(certService.queryCertsByCaId(id));
+    }
+
+    @Operation(summary = "删除 CA（被证书引用时拒绝）",
+            description = "删除 CA。<b>仍被证书引用时拒绝</b>，并在错误信息里点名是哪些证书在占位 ——"
+                    + "先处理掉那些证书（删除或改由别的 CA 签发）再删 CA。<br>"
