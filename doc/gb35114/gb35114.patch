+    @Override
+    public Gb35114Cert queryTrustedPlatformCert(String serverGbId) {
+        return resolveByPurpose(Gb35114Cert.PURPOSE_TRUSTED_PLATFORM, serverGbId, "上级服务端证书");
+    }
