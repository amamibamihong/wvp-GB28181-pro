+-- ---- CA 表新增列 ----
+-- 老库这里补的仍是 purpose，由后面的迁移段统一改名为 type —— 与证书表同步，
+-- 也让紧随其后的「存量数据归类」能照旧按 purpose 写入。
+-- 新装库建表时就是 type，两个条件都不成立，本段跳过。
+DECLARE
+V_CNT INT;
+V_TYPE INT;
+BEGIN
+SELECT COUNT(*) INTO V_CNT FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'WVP_GB35114_CA' AND COLUMN_NAME = 'PURPOSE';
+SELECT COUNT(*) INTO V_TYPE FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'WVP_GB35114_CA' AND COLUMN_NAME = 'TYPE';
+IF V_CNT = 0 AND V_TYPE = 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_ca ADD purpose varchar(20) default ''LOCAL_CA''';
+        EXECUTE IMMEDIATE 'COMMENT ON COLUMN wvp_gb35114_ca.purpose IS ''用途：LOCAL_CA-本地CA（可签发），TRUSTED_CA-上级CA（仅公钥，标识签发者）''';
+END IF;
+END;
