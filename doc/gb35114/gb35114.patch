+     *
+     * @param serverGbId 上级平台国标编码，可为 null
+     */
+    Gb35114Cert queryTrustedPlatformCert(String serverGbId);
+
+    /** 加载证书 PEM 为 X509Certificate（不涉私钥）。 */
+    X509Certificate loadCert(int id);
+
