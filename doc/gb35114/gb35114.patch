+  port: 5060
+  domain: 3502000000
+  id: 35020000002000000001
+  # 默认设备认证密码（Digest 注册用）
+  password: ${WVP_PWD}
+  alarm: false
+  timeout: 1000
+
+# GB35114 国密 A 级配置
