+    @Override
+    public void deleteCa(int id) {
+        int used = certMapper.countByCaId(id);
+        if (used > 0) {
+            throw new IllegalArgumentException("该 CA 下仍有 " + used + " 张证书（"
+                    + describeCertsByCaId(id) + "），请先删除或改签后再删除 CA");
+        }
+        caMapper.delete(id);
+    }
