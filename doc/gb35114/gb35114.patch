+++ b/docker/gb35114-deploy/.env.example
@@ -0,0 +1,31 @@
+# GB35114 测试部署环境变量
+#
+# 用法：cp .env.example .env 后填写各值。.env 已在 .gitignore 中，不会进版本库。
+#
+# 外置配置（config/application-host.yml、config/application.yml）与 docker-compose.yml
+# 里全是 ${VAR} 占位符，口令一律从本文件取，两边同源 —— 改一处即可，
+# 不会出现「compose 用了新口令、应用还在用旧口令」这类只在启动时才暴露的错配。
+#
+# 本文件是占位示例，填的是示例值；**不要**把真实口令提交上来。
+
+# ---- 部署目标 ----
+# 部署服务器地址（deploy.sh 用；也用于日志里打印访问地址）
+WVP_SERVER=192.0.2.10
+
+# ---- 数据库 ----
+# MySQL root 口令。docker-compose（建库）与 application-host.yml（应用连库）共用这一个
+MYSQL_ROOT_PASSWORD=change-me-mysql-root
+
+# ---- 本平台 SIP ----
+# 前端展示用 IP，填部署机对外可访问的地址
+WVP_SHOW_IP=192.0.2.10
+# GB28181 设备接入的默认 Digest 认证口令
+WVP_PWD=change-me-sip-pwd
+
+# ---- GB35114 ----
+# 私钥落地加密密钥。**生产环境必须改**，且改后已存私钥读不出来（需重新签发证书）
+WVP_GB35114_KEY_PWD=change-me-key-encrypt-pwd
+
+# ---- 流媒体 ----
+# ZLM 的 secret。本部署未启用媒体（media.rtp.enable=false），填占位值即可
+ZLM_SECRET=change-me-zlm-secret
