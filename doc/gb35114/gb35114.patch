+    }
+
+    /** 该类型是否由本平台持有私钥。 */
+    public static boolean holdsKey(String type) {
+        return TYPE_SERVER_IDENTITY.equals(type) || TYPE_DEVICE_IDENTITY.equals(type);
+    }
+}
