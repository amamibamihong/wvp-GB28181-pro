+-- 存量 CA 的 DN 各段回填：证书 PEM 无法在 SQL 里解析，只能按已有 subject_cn 兜底。
+-- 新生成/新导入的 CA 会由服务端从证书反解析自动写入。
+UPDATE wvp_gb35114_ca SET subject_dn = CONCAT('CN=', subject_cn) WHERE subject_dn IS NULL;
+
+-- ---- 索引 ----
+-- 建在「当前存在的那一列」上：老库是 purpose（迁移段改名时索引名一并统一），
+-- 新装库是 type。列名动态拼，避免新装库因 purpose 不存在而报错。
+DECLARE
+V_CNT INT;
+V_CNT_TYPE INT;
+V_HAS_PURPOSE INT;
+BEGIN
+-- 两个索引名都要查：老库建的是 idx_gb35114_cert_purpose，新装库建的是
+-- idx_gb35114_cert_type。只查其一会让另一条路径重跑时重复建索引而报错。
+SELECT COUNT(*) INTO V_CNT FROM SYSOBJECTS WHERE NAME = 'IDX_GB35114_CERT_PURPOSE' AND TYPE$ = 'SCHOBJ';
+SELECT COUNT(*) INTO V_CNT_TYPE FROM SYSOBJECTS WHERE NAME = 'IDX_GB35114_CERT_TYPE' AND TYPE$ = 'SCHOBJ';
+SELECT COUNT(*) INTO V_HAS_PURPOSE FROM USER_TAB_COLUMNS
+ WHERE TABLE_NAME = 'WVP_GB35114_CERT' AND COLUMN_NAME = 'PURPOSE';
+IF V_CNT = 0 AND V_CNT_TYPE = 0 THEN
+        IF V_HAS_PURPOSE > 0 THEN
+                EXECUTE IMMEDIATE 'CREATE INDEX idx_gb35114_cert_purpose ON wvp_gb35114_cert (purpose, gb_id)';
+        ELSE
+                EXECUTE IMMEDIATE 'CREATE INDEX idx_gb35114_cert_type ON wvp_gb35114_cert (type, gb_id)';
+        END IF;
+END IF;
+END;
+/
+
+/*============================================================================
+ * 存量数据归类（启发式，执行后请人工核对各 tab 归类是否正确）
+ * 达梦 clob 判空用 LENGTH(...) = 0
+ *
+ * 整段包在匿名块里并以「purpose 列还在不在」为闸：本段依赖 purpose（写入目标）与
+ * type（整数，推断依据）两列并存，而紧随其后的迁移段会把 purpose 改名为 type 并
+ * 删掉整数 type。重跑本脚本时 purpose 已不存在，裸跑这些 UPDATE 会因未知列报错 ——
+ * 有了这道闸，重复执行安全。
+ *============================================================================*/
+DECLARE
+V_HAS_PURPOSE INT;
+BEGIN
+SELECT COUNT(*) INTO V_HAS_PURPOSE FROM USER_TAB_COLUMNS
+ WHERE TABLE_NAME = 'WVP_GB35114_CERT' AND COLUMN_NAME = 'PURPOSE';
+IF V_HAS_PURPOSE > 0 THEN
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_cert SET purpose = ''TRUSTED_PLATFORM''
+     WHERE id IN (SELECT platform_cert_id FROM wvp_platform WHERE platform_cert_id IS NOT NULL)';
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_cert SET purpose = ''DEVICE_IDENTITY''
+     WHERE id IN (SELECT device_cert_id FROM wvp_platform WHERE device_cert_id IS NOT NULL)
+        OR id IN (SELECT cert_id FROM wvp_device WHERE cert_id IS NOT NULL)';
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_cert SET purpose = ''ISSUED_DEVICE''
+     WHERE type = 2 AND (key_pem IS NULL OR LENGTH(key_pem) = 0)';
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_cert SET purpose = ''DEVICE_IDENTITY''
+     WHERE type = 2 AND key_pem IS NOT NULL AND LENGTH(key_pem) > 0';
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_cert SET purpose = ''TRUSTED_PLATFORM''
+     WHERE type = 1 AND (key_pem IS NULL OR LENGTH(key_pem) = 0)';
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_cert SET purpose = ''SERVER_IDENTITY''
+     WHERE type = 1 AND key_pem IS NOT NULL AND LENGTH(key_pem) > 0';
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_cert SET purpose = ''ISSUED_DEVICE'' WHERE purpose IS NULL';
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_ca SET purpose = ''LOCAL_CA''
+     WHERE key_pem IS NOT NULL AND LENGTH(key_pem) > 0';
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_ca SET purpose = ''TRUSTED_CA''
+     WHERE purpose IS NULL OR key_pem IS NULL OR LENGTH(key_pem) = 0';
+    EXECUTE IMMEDIATE 'UPDATE wvp_gb35114_cert SET key_usage = ''digitalSignature'' WHERE key_usage IS NULL';
+END IF;
+END;
+/
+
+-- DN 兜底回填与 purpose 无关，可无条件执行
+UPDATE wvp_gb35114_cert SET subject_dn = 'CN=' || subject_cn WHERE subject_dn IS NULL;
+
+/*============================================================================
+ * 合并 purpose 与整数 type 为单一 type 列。
+ *
+ * 背景：证书表曾同时存在 purpose varchar（四个字符串取值）与 type integer
+ * （1-服务器证书/2-设备证书）。后者只是前者的派生投影 —— 全代码库写入点 2 处、
+ * 读取点 0 处 —— 而且有损：SERVER_IDENTITY（本平台作 UAS）与 TRUSTED_PLATFORM
+ * （上级平台作 UAS）方向相反，却同落成 1。现在一个概念一个名字。
+ *
+ * 位置：必须排在「存量数据归类」之后 —— 那段靠整数 type（1/2）推断用途，改完名
+ * 就无从推断了；也必须排在本文件其余所有 type 引用之前。
+ *
+ * 顺序不能反：先 DROP 整数 type 腾出列名，再把 purpose 改名为 type。
+ * CA 表同属「这一行是什么」，一并对齐为 type。
+ *
+ * 幂等：仅在 purpose 还在时执行；重复跑本脚本安全。
+ * 新装库没有 purpose（建表时就是 type varchar），本段整体跳过。
+ *============================================================================*/
+DECLARE
+V_CNT INT;
+V_HAS_PURPOSE INT;
+V_HAS_TYPE INT;
+BEGIN
+SELECT COUNT(*) INTO V_HAS_PURPOSE FROM USER_TAB_COLUMNS
+ WHERE TABLE_NAME = 'WVP_GB35114_CERT' AND COLUMN_NAME = 'PURPOSE';
+IF V_HAS_PURPOSE > 0 THEN
+    SELECT COUNT(*) INTO V_HAS_TYPE FROM USER_TAB_COLUMNS
+     WHERE TABLE_NAME = 'WVP_GB35114_CERT' AND COLUMN_NAME = 'TYPE';
+    IF V_HAS_TYPE > 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_cert DROP COLUMN type';
+    END IF;
+    EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_cert RENAME COLUMN purpose TO type';
+    EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_cert MODIFY type varchar(30) default ''ISSUED_DEVICE''';
+    EXECUTE IMMEDIATE 'COMMENT ON COLUMN wvp_gb35114_cert.type IS ''证书类型：SERVER_IDENTITY-服务端证书(本平台) / DEVICE_IDENTITY-客户端证书(本平台) / ISSUED_DEVICE-客户端证书(下级设备) / TRUSTED_PLATFORM-服务端证书(上级平台)''';
+
+    -- 索引名里带 purpose，改列名不会改索引名，重建为与新列名一致的名字
+    SELECT COUNT(*) INTO V_CNT FROM SYSOBJECTS WHERE NAME = 'IDX_GB35114_CERT_PURPOSE' AND TYPE$ = 'SCHOBJ';
+    IF V_CNT > 0 THEN
+        EXECUTE IMMEDIATE 'DROP INDEX idx_gb35114_cert_purpose';
+    END IF;
+    SELECT COUNT(*) INTO V_CNT FROM SYSOBJECTS WHERE NAME = 'IDX_GB35114_CERT_TYPE' AND TYPE$ = 'SCHOBJ';
+    IF V_CNT = 0 THEN
+        EXECUTE IMMEDIATE 'CREATE INDEX idx_gb35114_cert_type ON wvp_gb35114_cert (type, gb_id)';
+    END IF;
+END IF;
+
+SELECT COUNT(*) INTO V_HAS_PURPOSE FROM USER_TAB_COLUMNS
+ WHERE TABLE_NAME = 'WVP_GB35114_CA' AND COLUMN_NAME = 'PURPOSE';
+SELECT COUNT(*) INTO V_HAS_TYPE FROM USER_TAB_COLUMNS
+ WHERE TABLE_NAME = 'WVP_GB35114_CA' AND COLUMN_NAME = 'TYPE';
+IF V_HAS_PURPOSE > 0 AND V_HAS_TYPE = 0 THEN
+    EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_ca RENAME COLUMN purpose TO type';
+    EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_ca MODIFY type varchar(20) default ''LOCAL_CA''';
+    EXECUTE IMMEDIATE 'COMMENT ON COLUMN wvp_gb35114_ca.type IS ''类型：LOCAL_CA-本地CA(可签发，全局唯一) / TRUSTED_CA-受信任的CA(仅公钥，可重复导入)''';
+END IF;
+END;
+/
+
+
+/*============================================================================
+ * 按设备绑定它实际信任的那张服务器证书。
+ *
+ * 背景：UAS 签 sign2 时只能用一个私钥，而设备侧只信任它配置时导入的那张平台
+ * 证书的公钥。此前「按 id 倒序取最新」的隐式选择意味着新增一张服务器证书就会
+ * 静默顶掉旧证书，让所有按旧证书配置过的设备注册后立刻被 403 拒绝。
+ * 现在 SERVER_IDENTITY 由后端强制唯一（换发走「同密钥再签」原地更新），
+ * 未绑定设备的设备直接使用平台唯一的那张；此列只用于「设备信任的并非平台
+ * 当前签名身份」的例外情况。
+ * 达梦原生不支持 ADD COLUMN IF NOT EXISTS，用匿名块判列后添加。
+ *============================================================================*/
+DECLARE
+V_CNT INT;
+BEGIN
+SELECT COUNT(*) INTO V_CNT FROM USER_TAB_COLUMNS
+ WHERE TABLE_NAME = 'WVP_DEVICE' AND COLUMN_NAME = 'SERVER_CERT_ID';
+IF V_CNT = 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE wvp_device ADD server_cert_id int';
+END IF;
+END;
+/
+COMMENT ON COLUMN wvp_device.server_cert_id IS
+    '该设备信任的服务器证书ID（wvp_gb35114_cert.id，空则用平台唯一的那张服务端证书）';
+
+/*============================================================================
+ * 移除 is_default 列（如存在）。
+ *
+ * 该列曾用于在「同一密钥对签出的多张服务端证书」之间挑锚点。现已改为：后端强制
+ * SERVER_IDENTITY 至多一条未吊销记录，换发走「同密钥再签」原地更新（不新增行，
+ * 证书 ID 恒定，配置文件与设备绑定按 ID 的引用永不悬空），于是「选哪张」这个问题
+ * 本身消失了，标记默认既无必要也无意义。
+ *
+ * 存量的多行 SERVER_IDENTITY 不会被本脚本删除：本平台只保留一组密钥，但同组可以
+ * 有多张证书（换有效期/DN/签发者），它们公钥指纹相同、彼此可互换，都在用。
+ * 新代码取「id 最大的一张未吊销记录」作为签名身份。
+ *============================================================================*/
+DECLARE
+V_CNT INT;
+BEGIN
+SELECT COUNT(*) INTO V_CNT FROM USER_TAB_COLUMNS
+ WHERE TABLE_NAME = 'WVP_GB35114_CERT' AND COLUMN_NAME = 'IS_DEFAULT';
+IF V_CNT > 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_cert DROP COLUMN is_default';
+END IF;
+END;
+/
+
+/*============================================================================
+ * 公钥指纹：标识「同一个 SM2 签名身份」。
+ *
+ * 设备侧只保存一个平台公钥（无 CA 链校验，直接公钥比对），因此平台签 sign2 用的
+ * 私钥必须与设备导入的那张证书配对。若多张服务端证书共用同一密钥对（证书轮换：
+ * 只换有效期/DN/签发者），它们的公钥指纹相同、彼此可互换 —— 设备导入其中任意一张，
+ * 平台用同组任意一张的私钥签名都能被验过，换证书无需重新配置设备。
+ * 达梦原生不支持 ADD COLUMN IF NOT EXISTS，用匿名块判列后添加。
+ *============================================================================*/
+DECLARE
+V_CNT INT;
+V_IDX INT;
+BEGIN
+SELECT COUNT(*) INTO V_CNT FROM USER_TAB_COLUMNS
+ WHERE TABLE_NAME = 'WVP_GB35114_CERT' AND COLUMN_NAME = 'KEY_FINGERPRINT';
+IF V_CNT = 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_cert ADD key_fingerprint varchar(64)';
+END IF;
+
+-- 索引也判存在性，否则重跑本脚本会因索引已存在而报错。
+SELECT COUNT(*) INTO V_IDX FROM SYSOBJECTS
+ WHERE NAME = 'IDX_GB35114_CERT_FINGERPRINT' AND TYPE$ = 'SCHOBJ';
+IF V_IDX = 0 THEN
+        -- 本段排在迁移段之后，purpose 必已改名为 type，直接用 type 即可。
+        EXECUTE IMMEDIATE 'CREATE INDEX idx_gb35114_cert_fingerprint ON wvp_gb35114_cert (type, key_fingerprint)';
+END IF;
+END;
+/
+COMMENT ON COLUMN wvp_gb35114_cert.key_fingerprint IS
+    '公钥指纹（SM3 十六进制）；相同表示同一个签名身份，证书可互换';
+
+-- 存量证书的指纹无法在 SQL 里算（需解析 DER 取 SubjectPublicKeyInfo），
+-- 留空即可：新签发/新导入的证书会自动写入。
+--
+-- 核对：当前服务端证书 —— 按 id 倒序，第一条未吊销的即为签名身份；key_fingerprint
+-- 相同的一组表示共用同一密钥对，彼此可互换。本 SELECT 必须排在上面加列之后。
+SELECT id, gb_id, subject_cn, serial_number, not_after, key_fingerprint,
+       CASE WHEN key_pem IS NULL OR LENGTH(key_pem) = 0 THEN 0 ELSE 1 END AS has_key
+  FROM wvp_gb35114_cert WHERE type = 'SERVER_IDENTITY' ORDER BY id DESC;
+
+/*============================================================================
+ * 删除 CA 别名列（name）。
+ *
+ * CA 的身份就是它证书的主题 CN，另起一个别名只会让同一张 CA 在页面上有两个
+ * 都像名字的字段。该列自证书改造起就不再读写，此处从库里彻底移除。
+ * 幂等：判列存在后再删，重复执行安全。
+ *============================================================================*/
+DECLARE
+V_CNT INT;
+BEGIN
+SELECT COUNT(*) INTO V_CNT FROM USER_TAB_COLUMNS
+ WHERE TABLE_NAME = 'WVP_GB35114_CA' AND COLUMN_NAME = 'NAME';
+IF V_CNT > 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_ca DROP COLUMN name';
+END IF;
+END;
+/
+
+-- 核对：CA 表列清单里不应再有 name
+SELECT id, type, subject_cn, serial_number, not_after
+  FROM wvp_gb35114_ca ORDER BY type, id;
