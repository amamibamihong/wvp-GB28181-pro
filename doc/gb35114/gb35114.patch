+DECLARE
+V_CNT INT;
+BEGIN
+SELECT COUNT(*) INTO V_CNT FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'WVP_GB35114_CA' AND COLUMN_NAME = 'ORGANIZATION';
+IF V_CNT = 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE wvp_gb35114_ca ADD organization varchar(255)';
