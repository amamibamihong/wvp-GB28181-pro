+        assertTrue(Gb35114CertUtil.isSelfSigned(selfSigned.certificate), "前提：这是一张自签证书");
+
+        when(caMapper.queryAll())
+                .thenReturn(List.of(ca(10, Gb35114Ca.TYPE_TRUSTED_CA, selfSigned)));
