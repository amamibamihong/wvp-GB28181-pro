+    verify-upstream-cert-chain: ${WVP_GB35114_VERIFY_UPSTREAM_CERT_CHAIN:true}
+    # [可选] 是否跳过证书链签名验证，默认 false（验证）
+    # 拿不到 CA 时的逃生口。置 true 后不再要求「由已导入的 CA 签发」，
+    # 但指纹反查、吊销、有效期、握手验签都不受影响。
+    skip-cert-chain-verify: ${WVP_GB35114_SKIP_CERT_CHAIN_VERIFY:false}
+
