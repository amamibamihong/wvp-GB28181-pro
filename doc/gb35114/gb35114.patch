+    void certWithoutAnyRecordIsStillRejected() throws Exception {
+        Gb35114CertUtil.Gb35114Identity trusted = thirdPartyCa("Third Party CA");
+        Gb35114CertUtil.Gb35114Identity device = Gb35114CertUtil.issue(
