+  servlet:
+    multipart:
+      max-file-size: 10MB
+      max-request-size: 100MB
+  data:
+    redis:
+      host: wvp-gb35114-redis
+      port: 6379
+      database: 0
+      password:
+      timeout: 10000
+  datasource:
+    type: com.zaxxer.hikari.HikariDataSource
+    driver-class-name: com.mysql.cj.jdbc.Driver
+    url: jdbc:mysql://wvp-gb35114-mysql:3306/wvp?useUnicode=true&characterEncoding=UTF8&rewriteBatchedStatements=true&serverTimezone=PRC&useSSL=false&allowMultiQueries=true&allowPublicKeyRetrieval=true
+    username: root
+    # 与同目录 docker-compose.yml 的 MYSQL_ROOT_PASSWORD 同源（由 .env 提供）
+    password: ${MYSQL_ROOT_PASSWORD}
+    hikari:
+      connection-timeout: 20000
+      maximum-pool-size: 20
+      minimum-idle: 5
+
+server:
+  port: 18978
+  ssl:
+    enabled: false
+
