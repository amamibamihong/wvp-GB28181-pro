+    private String issuerDn;
+
+    /** 证书是否自签（issuer == subject，瞬态）。 */
+    @Schema(description = "是否自签（瞬态）")
+    private Boolean selfSigned;
+
+    /**
+     * 导入时发现的问题提示（瞬态，仅导入响应填充，不落库）。
+     *
+     * <p>导入设备证书时，若签发它的 CA 还没导入本平台，这里带一条提示。<b>不阻断导入</b>：
